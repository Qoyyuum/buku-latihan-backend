# Copy each variable into the Coolify dashboard's "Environment Variables"
# for the compose deployment. Every entry below also has a fallback default
# baked into compose.coolify.yaml — the dashboard value always wins.
#
# Required — replace every change-me:

DJANGO_SECRET_KEY=change-me          # `openssl rand -hex 32`
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me        # >= 8 chars
OPENROUTER_API_KEY=change-me

# Domains — set to the FQDNs you assign in Coolify (api + minio services).
# These are comma-separated lists where the code accepts lists.

DJANGO_ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com   # wherever the SPA/app lives
AWS_S3_ENDPOINT_URL=https://s3.example.com     # MinIO's public domain

# Optional — defaults shown:

# POSTGRES_DB=buku
# POSTGRES_USER=buku
# AWS_STORAGE_BUCKET_NAME=buku-latihan-media
# AWS_S3_REGION_NAME=auto
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  (default: MinIO root credentials)
# DATABASE_URL            (default: postgres://<user>:<password>@db:5432/<db>)
# CELERY_BROKER_URL       (default: redis://redis:6379/0)
# CELERY_RESULT_BACKEND   (default: redis://redis:6379/0)
# DJANGO_DEBUG=False
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_TRANSCRIBE_MODEL=openrouter/free
# OPENROUTER_GRADE_MODEL=typesafe/jev-1.13
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=buku-latihan
