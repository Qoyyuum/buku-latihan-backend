# Copy to deploy/.env and fill in. Never commit the real file.

# Public hostname — "localhost" for HTTP-only testing, real domain gets HTTPS.
DOMAIN=example.com

# PostgreSQL
POSTGRES_DB=buku
POSTGRES_USER=buku
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://buku:change-me@db:5432/buku

# Django
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=example.com
CORS_ALLOWED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Object storage (Cloudflare R2 recommended)
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=buku-latihan-media
AWS_S3_REGION_NAME=auto

# OpenRouter grading
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIBE_MODEL=openrouter/free
OPENROUTER_GRADE_MODEL=typesafe/jev-1.13

# Frontend build (baked into the JS bundle at export time)
EXPO_PUBLIC_API_URL=https://example.com
