# Copy to backend/.env and fill in for local development.

DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://buku:buku@localhost:16432/buku
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Local MinIO (deploy/compose.dev.yaml) or R2
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=buku-latihan-media
AWS_S3_REGION_NAME=auto

OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIBE_MODEL=openrouter/free
OPENROUTER_GRADE_MODEL=typesafe/jev-1.13
