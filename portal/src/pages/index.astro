---
import Base from "../layouts/Base.astro";
---

<Base title="Home">
  <section class="hero">
    <img src="/logo.png" alt="Buku Latihan" />
    <h1>Practice makes perfect.</h1>
    <p class="tagline">
      Buku Latihan is a free app for practicing past-year exam papers and
      exercises. Write your answers on worksheets with a stylus, submit them,
      and get marked by teachers.
    </p>
    <p>
      <a class="btn" href="/signup">Create a free account</a>
    </p>
  </section>

  <section>
    <h2>What is Buku Latihan?</h2>
    <p>
      <em>Buku Latihan</em> — "exercise book" in Malay — is a study companion
      for students, teachers, and parents:
    </p>
    <ul>
      <li>
        <strong>Students</strong> answer real past-year questions and structured
        exercises, drawing and writing directly on digital worksheets.
      </li>
      <li>
        <strong>Teachers</strong> create classrooms, assign worksheets, and
        review marked work.
      </li>
      <li>
        <strong>Parents</strong> get read-only visibility into their child's
        progress.
      </li>
    </ul>
  </section>

  <section>
    <h2>Your data, your control</h2>
    <p>
      You can change your password, enable two-factor authentication, or
      permanently delete your account and its data at any time from your
      <a href="/account">account page</a> — no need to contact support.
    </p>
  </section>
</Base>
