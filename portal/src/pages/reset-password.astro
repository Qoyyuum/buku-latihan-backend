---
import Base from "../layouts/Base.astro";
---

<Base title="Reset password">
  <h1>Reset password</h1>
  <div id="msg"></div>

  <form id="request-form" class="stack" hidden>
    <p class="muted">
      Enter your account email and we'll send you a reset link.
    </p>
    <label>
      Email
      <input name="email" type="email" required autocomplete="email" />
    </label>
    <button class="btn" type="submit">Send reset link</button>
  </form>

  <form id="confirm-form" class="stack" hidden>
    <label>
      New password
      <input
        name="password"
        type="password"
        required
        autocomplete="new-password"
      />
    </label>
    <button class="btn" type="submit">Set new password</button>
  </form>

  <script>
    import { post, errorMessage } from "../lib/api";

    const msg = document.getElementById("msg")!;
    const show = (text: string, ok = false) => {
      msg.innerHTML = `<div class="alert ${ok ? "ok" : "error"}">${text}</div>`;
    };
    const key = new URLSearchParams(window.location.search).get("key");
    const requestForm = document.getElementById(
      "request-form",
    ) as HTMLFormElement;
    const confirmForm = document.getElementById(
      "confirm-form",
    ) as HTMLFormElement;

    (key ? confirmForm : requestForm).hidden = false;

    requestForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const res = await post("/auth/password/request", {
        email: requestForm.email.value,
      });
      if (res.ok || res.status === 400 || res.status === 401) {
        // Don't reveal whether the email exists.
        show(
          "If that email is registered, a reset link is on its way. Check your inbox.",
          true,
        );
        requestForm.hidden = true;
      } else {
        show("Something went wrong. Please try again.");
      }
    });

    confirmForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const res = await post("/auth/password/reset", {
        key,
        password: confirmForm.password.value,
      });
      const data = await res.json().catch(() => null);
      // Headless reports 401 (with no errors) on success: the user is
      // simply not logged in after the reset.
      const succeeded = res.ok || (res.status === 401 && !data?.errors);
      if (succeeded) {
        show(
          'Password updated. <a href="/login">Log in</a> with your new password.',
          true,
        );
        confirmForm.hidden = true;
      } else {
        show(errorMessage(data));
      }
    });
  </script>
</Base>
